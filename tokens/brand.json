  "web": {
    "texture": {
      "dark": "obsidian",
      "light": "marble"
    },
    "brandAccent": {
      "dark": "base-cerulean",
      "light": "base-blue"
    },
    "headlines": {
      "$comment": "Website headlines scale fluidly above `title` (brand README, Typography). Each grows linearly from its type role's size at `from` to `max` at `to`, keeps the role's weight, and keeps the negative tracking of `display` in em so it holds at every size. scripts/build.mjs writes them to the website CSS as --cd-headline-*.",
      "from": "375px",
      "to": "1280px",
      "display": { "role": "display", "max": "88px", "lineHeight": 1, "letterSpacing": "-0.03em" },
      "title": { "role": "title", "max": "52px", "lineHeight": 1.05, "letterSpacing": "-0.02em" }
    },
    "video": {
      "$comment": "Website footage (brand/sections/5-footage.md): screen recordings of the app shown inside the site's device frame. Times in ms, sizes in px. scripts/build.mjs writes the delivery aspect to the website CSS as --cd-video-aspect.",
      "master": { "width": 1179, "height": 2556, "fps": 60 },
      "delivery": { "width": 590, "height": 1278, "fps": 30, "gop": 1000, "maxBytes": 1000000 },
      "playOnce": { "duration": 4000, "settleBy": 3500 },
      "loop": { "duration": 15000, "vignettes": 3, "maxChange": 520, "minHold": 2000 }
    },
    "scroll": {
      "$comment": "Website scroll motion (brand/sections/2-motion.md, On the website): the most a layer may move against the scroll, and the corner a scene stage starts from when it grows to full width. scripts/build.mjs writes them as --cd-scroll-*.",
      "parallaxMax": "48px",
      "insetRadius": "radius-xl"
    }
  },
  "motion": {
    "duration": {
      "fast": 180,
      "base": 260,
      "slow": 380,
      "slower": 520
    },
    "easing": {
      "$comment": "The timing curves of brand/sections/2-motion.md as CSS: enter with ease-out cubic, exit with ease-in cubic, choreographed moves (the Square-wipe) ease-in-out cubic. The app uses Reanimated's Easing.out/in/inOut(Easing.cubic); these are the same curves for the website (--cd-ease-*).",
      "out": "cubic-bezier(0.33, 1, 0.68, 1)",
      "in": "cubic-bezier(0.32, 0, 0.67, 0)",
      "inOut": "cubic-bezier(0.65, 0, 0.35, 1)"
    },
    "spring": {
      "snappy": {
        "damping": 18,
        "stiffness": 220,
        "mass": 0.8
      },
      "soft": {
        "damping": 22,
        "stiffness": 140,
        "mass": 1
      },
      "bouncy": {
        "damping": 12,
        "stiffness": 200,
        "mass": 0.7
      }
    },
    "staggerCellMs": 40,
    "centerBurstHoldMs": 120,
    "pressScale": 0.03,
    "pressOpacity": 0.1,
    "splash": {
      "$comment": "From motion/splash/splashMath.ts (SPLASH_TIMING). Draw order a-stem → a-arm → b-stem → b-arm, one piece at a time.",
      "start": 40,
      "dur": 200,
      "gap": 20,
      "bumpDur": 220,
      "bumpScale": 0.035,
      "hold": 40,
      "exitDur": 220,
      "exitScale": 0.08,
      "gradientFadeIn": 400,
      "markScale": 0.74,
      "order": [
        "a-stem",
        "a-arm",
        "b-stem",
        "b-arm"
      ]
    }
  },
  "season": {
    "$comment": "null = follow the date windows in themes/seasonal/*.json (only files with \"enabled\": true). A string id forces that season; \"none\" forces none.",
    "force": null
  }
}
